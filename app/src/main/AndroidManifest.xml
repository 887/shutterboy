<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

<!-- Media discovery: API 33+ uses READ_MEDIA_IMAGES + READ_MEDIA_VIDEO,
         API <=32 uses READ_EXTERNAL_STORAGE. MediaImagesPermission.kt picks
         the right set at runtime. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".ShutterboyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Shutterboy">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|locale|layoutDirection|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" chooser for image + video URIs. Mirrors
                 the Aves manifest shape exactly because some OEMs
                 (Samsung One UI, MIUI) only show apps in the chooser
                 when their filter declares BROWSABLE alongside
                 DEFAULT, and several camera apps issue intents
                 already tagged BROWSABLE for the gallery hand-off.
                 Spelling out schemes (content / file / http / https)
                 is belt-and-braces: per the docs a MIME-only filter
                 implies content+file, but the working pattern across
                 every gallery app that shows up in the user's
                 "Complete action using" sheet lists them
                 explicitly — we follow suit instead of arguing with
                 reality. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- ACTION_EDIT — camera apps and gallery apps fire this
                 when the user taps "edit" on a photo. We don't ship
                 a real editor yet; we open the viewer so the user
                 can at least see, zoom, share. Better than not
                 appearing in the chooser at all. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
