<?xml version="1.0" encoding="utf-8"?>
<!--
    Cold-start window background for Shutterboy.

    The Android 12+ SplashScreen API hard-clips windowSplashScreenAnimatedIcon
    to a circle, which crops the launcher artwork to its inscribed circle and
    hides the camera body / corners of the design. We bypass that by leaving
    the SplashScreen icon items unset and drawing the full square launcher
    foreground ourselves as the activity's windowBackground: solid launcher
    background colour underneath, the foreground bitmap centred on top at its
    native size. The user sees the whole square design during cold start
    instead of an inscribed circle.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launcher_background" />
    <item>
        <bitmap
            android:src="@mipmap/ic_launcher_foreground"
            android:gravity="center" />
    </item>
</layer-list>
