<?xml version="1.0" encoding="utf-8"?>
<!--
  Shutterboy — canonical English string resources. **Source of truth.**

  i18n discipline (locked from Phase 0 onward):

    Every user-facing string lands here in the SAME COMMIT that introduces
    its surface. No inline `Text("…")` or `contentDescription = "…"` literals
    in `ui/**`. testTag / log tags / debug-only strings / format-string
    constants / internal sentinels stay literal — those are not user-facing.

  Naming scheme: `<surface>_<role>` lowercase snake.
  Surfaces:
    - photos_       — Photos tab (timeline, density zoom, year scrubber)
    - collections_  — Collections tab (folders + smart albums)
    - viewer_       — Fullscreen viewer (pager, EXIF panel, actions)
    - search_       — Search overlay (filter chips, recent searches)
    - settings_     — Settings root + sub-pages
    - dialog_       — Dialogs (confirm, picker, info)
    - error_        — Error / failure messaging
    - cd_           — Content descriptions for icon-only actions

  Locale variants live at `values-<locale>/strings.xml` and override
  selected keys; missing keys fall back to English at runtime (Android
  default behaviour). See CLAUDE.md "Translations" section for the
  per-language session workflow.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
    <string name="app_name">shutterboy</string>

    <!-- Phase C — bottom navigation + tab labels. -->
    <string name="nav_photos">Photos</string>
    <string name="nav_collections">Collections</string>
    <string name="nav_settings">Settings</string>
    <string name="cd_nav_photos">Photos tab</string>
    <string name="cd_nav_collections">Collections tab</string>
    <string name="cd_nav_settings">Settings tab</string>

    <!-- Phase C — placeholder titles for each tab body until C.2/D/I fill them in. -->
    <string name="photos_placeholder_title">Photos timeline lands in C.2</string>
    <string name="collections_placeholder_title">Collections lands in Phase D</string>
    <string name="settings_placeholder_title">Settings lands in Phase I</string>
</resources>
