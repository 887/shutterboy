<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Shutterboy runs the SplashScreen API as the launch theme so the
        cold-boot frame hands off cleanly to Compose without a white
        flash. The Android 12+ SplashScreen icon area is a hard-coded
        circle, which clips the square launcher artwork to its inscribed
        circle — hiding the camera body / corners. To show the full
        square design at cold start we skip the windowSplashScreen* icon
        items entirely and draw a layer-list windowBackground: launcher
        background colour underneath, the foreground bitmap centred on
        top. installSplashScreen() in MainActivity still hands off
        cleanly even when the icon items are absent.

        - postSplashScreenTheme: the regular Shutterboy theme that
          MainActivity continues to render under once Compose mounts.
        - android:windowBackground: the layer-list described above.
    -->
    <style name="Theme.Shutterboy" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.Shutterboy.Main</item>
        <item name="android:windowBackground">@drawable/splash_window_background</item>
    </style>

    <style name="Theme.Shutterboy.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launcher_background</item>
    </style>

</resources>
